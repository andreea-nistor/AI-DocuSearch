# Example environment variables for running the agent
# Copy to .env and fill values before running

# Generic LLM provider config — works with any OpenAI-compatible chat completions API
# (OpenAI, xAI/Grok, Groq, Together, etc.)
LLM_API_KEY=
LLM_API_BASE=https://api.x.ai/v1
LLM_MODEL=grok-4
# Sampling temperature (0.0 = deterministic/focused, 1.0 = more varied). A temperature directive
# on the first line of a prompt file takes precedence in the web app.
LLM_TEMPERATURE=0.2

# --- Examples for other providers (uncomment and adjust one) ---
# OpenAI:
# LLM_API_BASE=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# Groq:
# LLM_API_BASE=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.1-70b-versatile

# Legacy variable names (still supported as fallbacks for backward compatibility)
# OPENAI_API_KEY=
# XAI_API_KEY=
# GROK_API_KEY=
# XAI_API_BASE=
# XAI_MODEL=
# GROK_MODEL=

# LangSmith (optional tracing/observability dashboard: https://smith.langchain.com)
# Get a key from https://smith.langchain.com/settings, then set LANGSMITH_TRACING=true.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-docusearch
# Send Helpful/Not helpful ratings to the corresponding LangSmith runs.
LANGSMITH_FEEDBACK_ENABLED=true

# App/runtime config
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
# Used only when a pipeline caller omits use_embeddings (for example, the CLI). The Streamlit app
# explicitly passes use_embeddings=True, so this setting does not select the web retrieval mode.
DOCUSEARCH_LITE_MODE=true

# Question history tracking (Step 6 - optional)
HISTORY_ENABLED=true
HISTORY_RETENTION_DAYS=30
HISTORY_LIMIT=10
# Feedback JSON files older than this are removed at app start
FEEDBACK_RETENTION_DAYS=90

# OCR / PDF rendering binaries (local Windows only; Streamlit Cloud uses packages.txt)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# POPPLER_PATH=C:\poppler\Library\bin

# Multimodal picture interpretation (disabled by default)
# When enabled, each PDF page (up to MEDIA_MAX_PAGES) and standalone PNG/JPEG/WebP upload is
# sent once to a vision-capable model at upload time; descriptions are attached to page chunks
# and answers disclose when an AI-generated picture description was used.
MULTIMODAL_ENABLED=false
# Vision-capable model on the same LLM_API_BASE (falls back to LLM_MODEL when empty)
VISION_MODEL=
MEDIA_MAX_PAGES=25
MEDIA_MAX_IMAGE_PIXELS=20000000
VISION_RENDER_DPI=110
VISION_MAX_IMAGE_EDGE=1568